# Add provider keys only when a real tool requires them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional override for where this service's local state (capability token,
# pidfile, installations.toml) lives. When unset, it uses the platform user
# data directory. Development checkouts typically set it to keep state
# inside the repo:
EXAMPLE_SERVICE_DATA_DIR=./data

# Extra Host headers the --http transport should accept beyond loopback
# (comma-separated) — the hostname of whatever fronts the loopback port
# (a tunnel, a reverse proxy).
EXAMPLE_SERVICE_ALLOWED_HOSTS=
