# Where this MCP server's own local state (capability token, pidfile,
# installations.toml) lives. When unset, it uses the platform user data
# directory.
ALEXANDRIA_DATA_DIR=./data

# Path to the Alexandria checkout the server reads research/ from. When
# unset, it's detected by walking up from the process's cwd looking for
# docs/DESIGN.md + AGENTS.md. Set this explicitly for a systemd service or
# any process whose cwd isn't the checkout (the "wingman.env" pattern —
# put these three path settings in
# ~/.config/alexandria/alexandria.env on a server host).
ALEXANDRIA_REPO=

# Extra Host headers the --http transport should accept beyond loopback
# (comma-separated) — the hostname of whatever fronts the loopback port.
ALEXANDRIA_ALLOWED_HOSTS=

# Optional overrides used by alexandria-ctl for its managed HTTP process.
# ALEXANDRIA_LOG=~/.local/state/alexandria-mcp.log

# OpenRouter credentials are loaded from the environment first, then from
# this local secrets file. The file is never read into the browser or repo.
ALEXANDRIA_SECRETS_FILE=~/.config/alexandria/secrets.env
# OPENROUTER_API_KEY=  # put this in the secrets file, never in the repository

# Optional. Lets the GitHub resolver read private repositories; public URLs
# resolve without it. Goes in the same secrets file as the OpenRouter key.
# A fine-grained PAT needs only Contents: Read on the repositories you
# commission from; a classic PAT needs the `repo` scope.
# GITHUB_TOKEN=
